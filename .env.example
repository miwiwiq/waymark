# Optional: copy to .env to override the defaults in docker-compose.yml.
# The stack runs without it; Google login stays hidden until both keys are set.

# Google OAuth client (redirect URI: http://localhost:8080/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev defaults. Change them for anything beyond local use.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
OAUTH_SESSION_SECRET=dev-oauth-session-secret-change-me
AUTH_DB_PASSWORD=auth
USERS_DB_PASSWORD=users
FEED_DB_PASSWORD=feed
MONGO_USER=waymark
MONGO_PASSWORD=waymark
RABBITMQ_USER=waymark
RABBITMQ_PASSWORD=waymark
# MinIO requires a password of at least 8 characters.
MINIO_ROOT_USER=waymark
MINIO_ROOT_PASSWORD=waymark-secret

# Authors with at least this many followers get their latest 20 posts cached (F3).
# Low so a demo with a few accounts goes through the cache; a real value would be far higher.
POPULAR_FOLLOWER_THRESHOLD=2
